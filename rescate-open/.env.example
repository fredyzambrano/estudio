# ============================================================
# RESCATE OPEN — Variables de entorno (EJEMPLO)
#
# Copia este archivo a .env.local para desarrollo. NUNCA lo llenes
# con valores reales aquí: este archivo va a Git.
#
# En producción, los secretos se configuran en el proveedor:
#   npx wrangler secret put NOMBRE
# ============================================================

# ---------- Público ----------

# URL canónica de la aplicación. Debe coincidir con el subdominio real.
APP_URL=https://app.tudominio.co

# Orígenes autorizados para CORS, separados por coma.
# Lista blanca estricta: el Worker no refleja el Origin recibido.
ORIGENES_PERMITIDOS=https://app.tudominio.co

# ---------- Secretos (NUNCA con valor en este archivo) ----------

# Sal para seudonimizar direcciones IP en la auditoría.
# Genera con: openssl rand -base64 32
# Al rotarla, los seudónimos anteriores dejan de correlacionarse con los nuevos.
SAL_AUDITORIA=

# Sal para el hash de los tokens de sesión.
# Genera con: openssl rand -base64 32
# ATENCIÓN: rotarla invalida TODAS las sesiones activas.
SAL_TOKENS=

# ---------- Pendientes de implementar ----------
# Estas variables todavía no las usa ningún código. Están aquí para que
# el día que se implementen no se inventen nombres nuevos.

# Envío de correo transaccional (verificación de cuenta, avisos operativos)
# CORREO_API_KEY=
# CORREO_REMITENTE=no-responder@tudominio.co

# Almacenamiento cifrado de documentos de verificación y evidencias
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Notificación interna de incidentes
# ALERTAS_WEBHOOK=

# ============================================================
# Comprobación antes de desplegar:
#   - Ningún valor real en este archivo
#   - .env y .env.local en .gitignore
#   - git log -p --all -- .env  →  sin resultados
# ============================================================
