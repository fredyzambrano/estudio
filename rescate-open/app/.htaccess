# ============================================================
# RESCATE OPEN — Apache / Hostinger (hosting compartido)
# Sube este archivo junto con index.html en la carpeta del subdominio.
# Las mismas cabeceras que aplica herramientas/servidor.js en local.
# ============================================================

# ---------- Forzar HTTPS ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ---------- Cabeceras de seguridad ----------
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # HSTS: actívalo SOLO cuando TODOS los subdominios estén en HTTPS.
  # Con un subdominio en HTTP, esta línea lo deja inaccesible durante un año.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # El estado del piloto vive en el navegador: no cachear el HTML.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ---------- Tipos MIME ----------
<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------- Archivos que no deben servirse nunca ----------
<FilesMatch "(^\.|\.(env|log|sql|toml|json)$)">
  Require all denied
</FilesMatch>

# Excepción: el manifiesto de la aplicación sí debe servirse.
<Files "manifest.webmanifest">
  Require all granted
</Files>

# ---------- Sin listado de directorios ----------
Options -Indexes

# ---------- Compresión ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/manifest+json
</IfModule>

# ---------- Página de error ----------
ErrorDocument 404 /index.html
