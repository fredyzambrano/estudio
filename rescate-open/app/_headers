# ============================================================
# RESCATE OPEN — Cloudflare Pages / Netlify
# Debe quedar en la raíz publicada, junto a index.html.
# ============================================================

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# HSTS: descomentar SOLO cuando todos los subdominios estén en HTTPS.
#  Strict-Transport-Security: max-age=31536000; includeSubDomains

/index.html
  Cache-Control: no-store, must-revalidate

/css/*
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=3600
